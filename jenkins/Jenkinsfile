// scripted pipeline
node {
    checkout scm // ambil repository terbaru

    def dockerImage = docker.image('python:3.11')

    dockerImage.inside() {
        
        env.CI = 'true'

        stage('Build') {
            sh '''
            echo "=== DEBUG START ==="
            pwd
            ls -R
            echo "=== DEBUG END ==="
            '''
            sh 'python3 -m py_compile sources/add2vals.py sources/calc.py'
        } // end of stage build
        
        if (currentBuild.result == 'UNSTABLE') return
        

        stage('Test') {
            try {
                sh '''
                pip install pytest
                pytest --verbose --junit-xml test-reports/results.xml sources/test_calc.py
                '''
            } finally {
                junit 'test-reports/results.xml'
            }
        } // end of stage test
        
        if (currentBuild.result == 'UNSTABLE') return


        // stage('Deliver') {
        //     try {
        //         sh 'pip install pyinstaller'
        //         sh 'pyinstaller --onefile sources/add2vals.py'

        //         archiveArtifacts 'dist/add2vals'
        //     } catch(err) {
        //         currentBuild.result = 'FAILURE'
        //         throw err
        //     }
        // } // end of stage deliver
        
        if (currentBuild.result == 'UNSTABLE') return
    } // end of dockerImage
}
