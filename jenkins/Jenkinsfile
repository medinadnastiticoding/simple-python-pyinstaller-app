// scripted pipeline
node {

    cleanWs() // bersihkan workspace
    checkout scm // ambil repository terbaru

    def dockerImage = docker.build('my-python-ci', './python-ci') // build image python di jenkins
    dockerImage.inside() {
        
        env.CI = 'true' // atur environment

        // Stage: Debug
        stage('Debug'){
            // echo 'Hello from Stage: Debug'
            sh '''
            echo "=== DEBUG START ==="
            pwd
            ls -R
            cat test-reports/results.xml || echo "NO REPORT FILE"
            echo "=== DEBUG END ==="
            '''
        }


        // Stage: Build
        stage('Build') {
            // echo 'Hello from Stage: Build'

            echo "=== BUILD START ==="
            sh 'python3 -m py_compile sources/add2vals.py sources/calc.py'
            echo "=== BUILD END ==="
        }
        if (currentBuild.result == 'UNSTABLE') return
        

        // Stage: Test
        stage('Test') {
            // echo 'Hello from Stage: Test'
            
            echo "=== DEPLOY START ==="
            try {
                sh '''
                mkdir -p test-reports
                pytest --verbose --junit-xml test-reports/results.xml sources/test_calc.py
                '''
            } finally {
                junit 'test-reports/results.xml'
            }
            echo "=== DEPLOY END ==="
        }
        if (currentBuild.result == 'UNSTABLE') return


        // Stage: Deliver
        stage('Deliver') {
            // echo 'Hello from Stage: Deliver'

            echo "=== DELIVER START ==="
            try {
                // make python file into executable
                sh '''
                    rm -rf build dist
                    pyinstaller --onefile sources/add2vals.py
                '''

                // check directory
                echo "check generated folder and files"
                sh 'ls -R dist'

                // produce
                archiveArtifacts artifacts: 'dist/add2vals'
            } catch(err) {
                currentBuild.result = 'FAILURE'
                throw err
            }
            echo "=== DELIVER END ==="
        }
        if (currentBuild.result == 'UNSTABLE') return

        // Stage: Deploy
        stage('Deploy') {

            // echo 'Hello from Stage: Deploy'

            echo "=== DEPLOY START ==="
            
            // run the app in the background
            sh '''
                chmod +x dist/add2vals
                nohup ./dist/add2vals > app.log 2>&1 &
            '''
            
            try{
                // set timer for timeout
                timeout(time: 5, unit: 'MINUTES'){
                    
                    input(
                        message: 'Sudah selesai menggunakan Aplikasi? (Klik "Proceed" untuk mengakhiri)',
                        ok: 'Stop App'
                    )
                } // end of timeout
            } finally {
                // notif of forcing the app to stop running
                echo 'Stop the application.'

                // stop the app
                sh '''
                    pkill -f add2vals || true
                '''
            }
            echo "=== DEPLOY END ==="
        }
        if (currentBuild.result == 'UNSTABLE') return

    } // end of dockerImage
}
